# cp .env.example .env 후 값을 바꿔서 사용 (.env는 커밋하지 않음)
DB_NAME=bingang
DB_USER=bingang
DB_PASSWORD=change-me

# 비워 두면 로컬 HTTP(:80). 서버에서는 도메인을 넣으면 Caddy가 HTTPS를 자동 설정
SITE_ADDRESS=

# 시간표 수집용 학생종합정보시스템 계정 (비우면 수집하지 않음, 절대 커밋하지 않기)
YU_USERNO=
YU_PASSWD=
# 수집할 학기 (U0320021 = 2학기)
TIMETABLE_YEAR=2026
TIMETABLE_SEMESTER_CODE=U0320021

# Grafana 관리자(admin) 비밀번호
GRAFANA_ADMIN_PASSWORD=change-me

# 알림을 받을 디스코드 채널 웹훅 주소 (채널 설정 → 연동 → 웹후크). 비우면 알림만 보내지 않는다
DISCORD_WEBHOOK_URL=
