{
  "uid": "bingang-usage",
  "title": "빈강 사용 현황",
  "tags": [
    "bingang"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "type": "stat",
      "title": "지금 사용자 (5분)",
      "description": "최근 5분 동안 접속한 사람 수 (고유 IP + 기기)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(sum by (ip, ua) (count_over_time({service=\"caddy\"} | json ip=\"request.client_ip\", ua=\"request.headers[\\\"User-Agent\\\"][0]\" | ua!~\"(?i).*(bingang-loadtest|curl|wget|bot|spider|crawl|python|go-http).*\" [5m])))",
          "queryType": "instant",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "최근 24시간 사용자",
      "description": "하루 사용자 수(DAU). 같은 와이파이·같은 기기 종류는 한 명으로 셀 수 있어 근사치",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(sum by (ip, ua) (count_over_time({service=\"caddy\"} | json ip=\"request.client_ip\", ua=\"request.headers[\\\"User-Agent\\\"][0]\" | ua!~\"(?i).*(bingang-loadtest|curl|wget|bot|spider|crawl|python|go-http).*\" [24h])))",
          "queryType": "instant",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 2,
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "최근 7일 사용자",
      "description": "주간 사용자 수(WAU)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(sum by (ip, ua) (count_over_time({service=\"caddy\"} | json ip=\"request.client_ip\", ua=\"request.headers[\\\"User-Agent\\\"][0]\" | ua!~\"(?i).*(bingang-loadtest|curl|wget|bot|spider|crawl|python|go-http).*\" [7d])))",
          "queryType": "instant",
          "instant": true
