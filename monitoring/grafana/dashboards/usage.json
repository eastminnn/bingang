      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 3,
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      }
    },
    {
      "type": "timeseries",
      "title": "일별 사용자",
      "description": "날짜별 고유 사용자 수",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "interval": "1d",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(sum by (ip, ua) (count_over_time({service=\"caddy\"} | json ip=\"request.client_ip\", ua=\"request.headers[\\\"User-Agent\\\"][0]\" | ua!~\"(?i).*(bingang-loadtest|curl|wget|bot|spider|crawl|python|go-http).*\" [$__interval])))",
          "legendFormat": "사용자",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "barAlignment": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "hidden",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "시간대별 사용자",
      "description": "1시간마다 고유 사용자 수. 쉬는 시간·점심 등 몰리는 시간을 본다",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "interval": "1h",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(sum by (ip, ua) (count_over_time({service=\"caddy\"} | json ip=\"request.client_ip\", ua=\"request.headers[\\\"User-Agent\\\"][0]\" | ua!~\"(?i).*(bingang-loadtest|curl|wget|bot|spider|crawl|python|go-http).*\" [$__interval])))",
          "legendFormat": "사용자",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "barAlignment": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "hidden",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "bargauge",
      "title": "건물별 조회 순위",
      "description": "선택한 기간 동안 건물 강의실을 연 횟수 (부하 테스트 제외)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sort_desc(topk(15, sum by (name) (round(increase(bingang_building_views_total[$__range])))))",
          "legendFormat": "{{name}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "text",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 16,
        "h": 12
      }
    },
    {
      "type": "piechart",
      "title": "지금 vs 시간 바꿔 보기",
      "description": "'지금' 그대로 본 조회와, 요일·시각을 바꿔 미리 본 조회의 비율",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (mode) (round(increase(bingang_building_views_total[$__range])))",
          "legendFormat": "{{mode}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "now"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "지금"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "scheduled"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "시간 바꿔 보기"
              }
            ]
          }
        ]
      },
      "options": {
        "pieType": "donut",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "values": [
            "value",
            "percent"
          ]
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 7,
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 12
      }
    }
