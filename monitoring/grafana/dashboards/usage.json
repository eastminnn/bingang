{
  "uid": "bingang-usage",
  "title": "빈강 사용 현황",
  "tags": [
    "bingang"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "type": "stat",
      "title": "지금 사용자 (5분)",
      "description": "최근 5분 동안 접속한 사람 수 (고유 IP + 기기)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(sum by (ip, ua) (count_over_time({service=\"caddy\"} | json ip=\"request.client_ip\", ua=\"request.headers[\\\"User-Agent\\\"][0]\" | ua!~\"(?i).*(bingang-loadtest|curl|wget|bot|spider|crawl|python|go-http).*\" [5m]))) or vector(0)",
          "queryType": "instant",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      }
    },
