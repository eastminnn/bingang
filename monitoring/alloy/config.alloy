// Docker에서 이 Compose 프로젝트(bingang)의 컨테이너를 찾아 로그를 Loki로 보낸다

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// 라벨은 검색 기준이 되는 적은 종류만 붙인다 (서비스 이름, 레벨)
discovery.relabel "containers" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "bingang"
    action        = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.process.levels.receiver]
}

loki.process "levels" {
  // Spring Boot는 ECS 형식 JSON으로 출력한다: {"log":{"level":"ERROR", ...}, ...}
  stage.match {
    selector = "{service=\"api\"}"

    stage.json {
      expressions = { level = "log.level" }
    }
    stage.labels {
      values = { level = "" }
    }
  }

  // Caddy는 {"level":"info", ...}
  stage.match {
    selector = "{service=\"caddy\"}"

    stage.json {
      expressions = { level = "level" }
    }
    stage.template {
      source   = "level"
      template = "{{ ToUpper .Value }}"
    }
    stage.labels {
      values = { level = "" }
    }
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
